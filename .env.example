NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortner
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Primary redirect hostname (also used to distinguish custom domain requests).
BACK_END_URL=http://localhost:8080/
# CNAME hostname only; the ingress must accept custom hosts and provision TLS.
CUSTOM_DOMAIN_TARGET=your-redirect-host.example

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PROVIDER_URI=https://www.googleapis.com/oauth2/v2/userinfo

# Original spelling retained for compatibility with existing deployments.
BRAVO_API_KEY=replace-me
CLOUDNARY_CLOUD_NAME=replace-me
CLOUDNARY_API_KEY=replace-me
CLOUDNARY_API_SECRET=replace-me
GEO_IP_API_KEY=replace-me
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
