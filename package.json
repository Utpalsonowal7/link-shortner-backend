{
  "name": "url_shortner_backend",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test --experimental-test-module-mocks test/*.test.ts",
    "postinstall": "prisma generate",
    "pretest": "npm run build",
    "test:ci": "node --import tsx --test --experimental-test-module-mocks --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results.xml test/*.test.ts",
    "pretest:integration": "npm run build",
    "test:integration": "node --import tsx --test --experimental-test-module-mocks --test-timeout=30000 test/integration/*.test.ts",
    "test:integration:ci": "node --import tsx --test --experimental-test-module-mocks --test-timeout=30000 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=integration-results.xml test/integration/*.test.ts"
  },
  "author": "Utpal Sonowal",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailgen": "^2.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.11.1",
    "ip-geolocation-api-javascript-sdk": "^3.0.1",
    "jsonwebtoken": "^9.0.3",
    "link-preview-js": "^5.0.0",
    "mailgen": "^2.0.34",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nanoid": "^5.1.16",
    "pg": "^8.21.0",
    "razorpay": "^2.9.8",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
